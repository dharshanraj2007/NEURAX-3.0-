# API server port.
PORT=4000

# SQLite file path. Relative paths resolve against server/ (this file's
# directory); use an absolute path to store the DB elsewhere.
DB_PATH=./data.sqlite

# Left unset on purpose: in dev, any http://localhost:<port> or
# http://127.0.0.1:<port> origin is allowed automatically, since Vite picks
# whatever port is free. Set this for production to pin the API to your
# real frontend's origin(s) -- comma-separated for more than one, e.g.:
# CORS_ORIGIN=https://app.example.com,https://staging.example.com
CORS_ORIGIN=
