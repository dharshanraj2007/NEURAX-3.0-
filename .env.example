# Left empty on purpose: in dev, API calls go through the Vite proxy
# (see vite.config.ts) to the backend on http://localhost:4000.
# Set this only if the frontend needs to reach a backend that ISN'T proxied
# (e.g. separate deployments): VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
